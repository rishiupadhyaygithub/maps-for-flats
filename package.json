{
  "name": "maps-for-flats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "scrape": "dotenv -e .env.local -- tsx scripts/scrape.ts",
    "scrape:mb": "dotenv -e .env.local -- tsx scripts/scrape.ts magicbricks",
    "scrape:99": "dotenv -e .env.local -- tsx scripts/scrape.ts 99acres",
    "scrape:housing": "dotenv -e .env.local -- tsx scripts/scrape.ts housing",
    "scrape:nb": "dotenv -e .env.local -- tsx scripts/scrape.ts nobroker",
    "playwright:install": "playwright install chromium",
    "seed": "dotenv -e .env.local -- tsx scripts/seed.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "playwright": "^1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
